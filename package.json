{
  "name": "smart-invoice-pro",
  "version": "2.0.0",
  "description": "White-label, offline-first PWA invoice and business management app for SMEs. Rebrandable via js/app.config.js — no build step, no backend.",
  "type": "module",
  "scripts": {
    "icons": "node scripts/generate-icons.js",
    "serve": "node scripts/serve.js",
    "test": "node scripts/test-core.js && node scripts/test-utils.js && node scripts/test-brand.js && node scripts/test-config.js && node scripts/test-license.js && node scripts/test-assets.js && node scripts/test-markup.js",
    "test:unit": "node scripts/test-core.js && node scripts/test-utils.js",
    "test:brand": "node scripts/test-brand.js",
    "test:config": "node scripts/test-config.js",
    "test:license": "node scripts/test-license.js",
    "test:assets": "node scripts/test-assets.js",
    "test:markup": "node scripts/test-markup.js",
    "test:e2e": "node scripts/e2e.js",
    "test:a11y": "node scripts/e2e.js --a11y-only",
    "test:polish": "node scripts/e2e.js --suite=test-polish.js",
    "test:responsive": "node scripts/e2e.js --suite=test-responsive.js",
    "test:platform": "node scripts/e2e.js --suite=test-platform.js",
    "test:charts": "node scripts/e2e.js --suite=test-charts.js",
    "test:all": "npm test && npm run test:e2e",
    "shots": "node scripts/e2e.js --shots"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "qrcode": "^1.5.4"
  }
}